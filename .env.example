# Healthcare Appointment & Follow-Up Manager - Environment Configuration

# Server Port
PORT=5000
NODE_ENV=development

# Database Connection (Neon Serverless PostgreSQL / Cloud PostgreSQL)
DATABASE_URL="postgresql://username:password@ep-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require"

# JWT Secret Key
JWT_SECRET="your-secure-jwt-secret"

# LLM Service API Keys (Optional - Automatic Intelligent Clinical Fallback Engine is active if unset)
GEMINI_API_KEY=""
OPENAI_API_KEY=""

# Email Notifications (Optional - Automatically falls back to Ethereal / Stream transporter for testing)
SMTP_HOST=""
SMTP_PORT=587
SMTP_USER=""
SMTP_PASS=""
EMAIL_FROM="CarePulse Health <no-reply@carepulse-health.org>"

# Google Calendar Integration (Optional - Direct web link & .ICS file generation works out-of-the-box)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REFRESH_TOKEN=""

# Frontend URL
CLIENT_URL="http://localhost:5173"
